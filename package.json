{
  "name": "dsh-diagram-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Code-as-diagram figures for DSH: renders flowcharts, DFDs, structure charts, UML, ER diagrams and more to PNG from a JSON spec.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "python",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "diagram",
    "diagram-as-code",
    "flowchart",
    "uml",
    "dfd",
    "png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpylin/drawing_tool.git"
  },
  "homepage": "https://github.com/cpylin/drawing_tool#readme",
  "bugs": {
    "url": "https://github.com/cpylin/drawing_tool/issues"
  },
  "license": "MIT"
}
